    "/api/workspaces/{id}/invitation/notification": {
      "post": {
        "summary": "Apply a signed invitation notification action for its recipient",
        "description": "Requires a Nextcloud session, CSRF token and an HMAC bound to the recipient, workspace, invitation generation and decision. View dismisses the notification while leaving the invitation pending. Accept and decline apply the response immediately.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "invitationId",
                  "decision",
                  "token"
                ],
                "properties": {
                  "invitationId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "view",
                      "accept",
                      "decline"
                    ]
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied"
          },
          "403": {
            "description": "Invalid signature or recipient"
          },
          "404": {
            "description": "Invitation is no longer pending"
          },
          "422": {
            "description": "Invalid parameters"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            }
          }
        }
      }
    }
  }
